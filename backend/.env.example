# Environment Variables — copy this to .env and fill in values
APP_NAME="NyayaSarathi API"
APP_VERSION="1.0.0"
DEBUG=true
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173"]'
JWT_SECRET_KEY=replace_with_a_secure_random_hex_key

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Google OAuth 2.0 (for Continue with Google on Login & Signup)
# Authorized redirect URIs to add in Google Cloud Console:
#   - Production: https://your-backend-api.onrender.com/api/auth/google/callback
#   - Local Dev:   http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-backend-api.onrender.com/api/auth/google/callback
FRONTEND_BASE_URL=https://your-frontend-app.vercel.app

# GNews API (for Indian Legal News feature)
# Get a free key at: https://gnews.io/
GNEWS_API_KEY=your-gnews-api-key-here

# --- Dedicated LLM Feature API Keys ---
# 1. Feature: Judgment Success Predictor & Explanation Engine (Gemini 1)
PREDICTOR_GEMINI_API_KEY=your-gemini-api-key-1
GEMINI_API_KEY=your-gemini-api-key-1
GEMINI_MODEL=gemini-1.5-flash

# 2. Feature: AI Legal Drafting & Pleading Generator (Gemini 2)
DRAFTING_GEMINI_API_KEY=your-gemini-api-key-2
DRAFTING_GEMINI_MODEL=gemini-1.5-flash

# 3. Feature: Legal Research & Document RAG Q&A Hub (Gemini 3)
RESEARCH_GEMINI_API_KEY=your-gemini-api-key-3
RESEARCH_GEMINI_MODEL=gemini-1.5-flash

# 4. Feature: Legal Translation & Regional Multilingual Synthesis (Gemini 4)
TRANSLATE_GEMINI_API_KEY=your-gemini-api-key-4
TRANSLATE_GEMINI_MODEL=gemini-1.5-flash

# 5. Feature: Trial War Room - Adversarial Bench Simulator (Groq 1)
WAR_ROOM_GROQ_API_KEY=your-groq-api-key-1
WAR_ROOM_MODEL=llama-3.3-70b-versatile

# 6. Feature: Contract Risk & Compliance Analyzer (Groq 2)
CONTRACTS_GROQ_API_KEY=your-groq-api-key-2
CONTRACTS_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your-groq-api-key-2
GROQ_MODEL=llama-3.3-70b-versatile

